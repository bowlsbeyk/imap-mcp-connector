# Copy to .env for local runs. On Railway, set these in the service's Variables.
# See docs/DEPLOY-RAILWAY.md for details.

# --- Mailbox (from your mail provider's IMAP/SMTP settings) ---
IMAP_HOST=
IMAP_PORT=993
SMTP_HOST=
SMTP_PORT=465
# 465 = SMTP_SECURE=true (TLS). 587 = SMTP_SECURE=false (STARTTLS, enforced).
SMTP_SECURE=true
MAIL_USER=
MAIL_PASSWORD=
# Optional: separate SMTP login, sender address, folder overrides
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=Your Name <you@yourcompany.com>
# SENT_FOLDER=
# DRAFTS_FOLDER=
# Set false if your provider already files sent mail in Sent automatically
SAVE_TO_SENT=true

# --- What Claude may do: read | draft | send ---
MODE=read
# Only allow sending to these addresses/domains (comma-separated)
# SEND_ALLOWLIST=@yourcompany.com,partner@example.org
MAX_SENDS_PER_HOUR=20

# --- Connector sign-in (what YOU type when connecting Claude) ---
# Railway sets this automatically from the generated domain; set it elsewhere.
# PUBLIC_URL=https://your-app.up.railway.app
AUTH_USER=
# Either a 16+ character password...
AUTH_PASSWORD=
# ...or a bcrypt hash from `npm run hash-password`
# AUTH_PASSWORD_HASH=
# Optional 2FA from `npm run totp-setup`
# AUTH_TOTP_SECRET=
# 32+ random characters (`npm run gen-secret`). Changing it logs out every client.
TOKEN_SECRET=
# Extra OAuth callbacks for non-Claude clients, e.g. MCP Inspector / Claude Code:
# EXTRA_REDIRECT_URIS=http://localhost:*
