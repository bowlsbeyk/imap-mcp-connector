# Mailbox
IMAP_HOST=mail.example.com
IMAP_PORT=993
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
MAIL_USER=you@example.com
MAIL_PASSWORD=change-me
# SENT_FOLDER=
# DRAFTS_FOLDER=
SAVE_TO_SENT=true

# Access: read | draft | send
MODE=read
# SEND_ALLOWLIST=@example.com
MAX_SENDS_PER_HOUR=20

# Connector sign-in
PUBLIC_URL=https://your-app.up.railway.app
AUTH_USER=owner
AUTH_PASSWORD_HASH=
# AUTH_TOTP_SECRET=
TOKEN_SECRET=
# EXTRA_REDIRECT_URIS=http://localhost:6274/oauth/callback
